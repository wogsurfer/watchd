---
// One "must see" list (core/canon on the backend): its films in order, the
// ones you've seen marked, and how far through it you are.
import Base from "../../layouts/Base.astro";
import { api, type CanonList } from "../../lib/api";
import wRed from "../../assets/watchd-w-red.png";
export const prerender = false;

const { token } = Astro.locals;
const { slug } = Astro.params;
Astro.response.headers.set("Cache-Control", "private, no-cache");

let list: CanonList | null = null;
let error = "";
try {
  list = await api.canon.list(slug!, token!);
} catch (e: unknown) {
  error = e instanceof Error ? e.message : String(e);
}
const pct = list && list.total ? Math.round((list.seen / list.total) * 100) : 0;
---

<Base title={list?.name ?? "List"}>
  <nav class="flex items-center gap-2 text-sm text-zinc-400 mb-6">
    <a href="/lists" class="hover:text-zinc-100 transition">Lists</a>
    <span class="text-zinc-700">/</span>
    <span class="text-zinc-100 font-bold truncate">{list?.name ?? "List"}</span>
  </nav>

  {error && <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-2xl mb-8 text-sm">{error}</div>}

  {list && (
    <div class="canon">
      <header class="canon-head">
        <h1 class="text-3xl md:text-5xl font-black text-zinc-100 tracking-tighter">{list.name}</h1>
        <p class="text-zinc-400 mt-2 max-w-2xl">{list.blurb}</p>
        <div class="canon-progress">
          <div class="canon-bar"><span style={`width:${pct}%`}></span></div>
          <p><b>{list.seen.toLocaleString()}</b> of {list.total.toLocaleString()} seen · {pct}%</p>
        </div>
        <div class="canon-filter" role="group" aria-label="Show">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          <button type="button" data-filter="unseen" aria-pressed="false">Not seen ({(list.total - list.seen).toLocaleString()})</button>
          <button type="button" data-filter="seen" aria-pressed="false">Seen ({list.seen.toLocaleString()})</button>
        </div>
      </header>

      <ul class="canon-grid">
        {list.items.map((m) => (
          <li data-seen={m.watched ? "1" : "0"}>
            <a href={`/media/movie/${m.tmdb_id}`} class={`canon-film ${m.watched ? "is-seen" : ""}`}>
              <div class="canon-poster">
                {m.poster_path
                  ? <img src={m.poster_path} alt={m.title} loading="lazy" decoding="async" />
                  : <span>{m.title}</span>}
                {list!.ranked && m.rank && <i class="canon-rank">{m.rank}</i>}
                {m.watched && <img class="canon-w" src={wRed.src} alt="Seen" />}
              </div>
              <b>{m.title}</b>
              <span>{m.ceremony ? `${m.year ?? ""} · Oscar ${m.ceremony}` : m.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</Base>

<style>
  .canon-head { margin-bottom: 28px; }
  .canon-progress { margin-top: 18px; max-width: 520px; }
  .canon-bar { height: 10px; border-radius: 999px; background: var(--color-zinc-800); overflow: hidden; }
  .canon-bar span { display: block; height: 100%; background: var(--color-red-600); border-radius: inherit; }
  .canon-progress p { margin-top: 8px; color: var(--color-zinc-400); font-size: 14px; }
  .canon-progress b { color: var(--color-zinc-100); font-size: 18px; }
  .canon-filter { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .canon-filter button {
    padding: 7px 14px; border-radius: 999px; border: 1px solid var(--color-zinc-800); background: var(--color-zinc-900);
    color: var(--color-zinc-400); font-size: 13px; font-weight: 800; cursor: pointer;
  }
  .canon-filter button[aria-pressed="true"] { background: var(--color-red-600); border-color: var(--color-red-600); color: #fff; }
  .canon-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 22px 16px; }
  .canon-film { display: grid; gap: 4px; min-width: 0; }
  .canon-film b { color: var(--color-zinc-100); font-size: 13px; font-weight: 800; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .canon-film > span { color: var(--color-zinc-500); font-size: 12px; }
  .canon-poster { position: relative; aspect-ratio: 2 / 3; border-radius: 12px; overflow: hidden; background: var(--color-zinc-900); border: 1px solid var(--color-zinc-800); margin-bottom: 4px; }
  .canon-poster > img:first-child { width: 100%; height: 100%; object-fit: cover; }
  .canon-poster > span { display: flex; align-items: center; justify-content: center; height: 100%; padding: 10px; text-align: center; color: var(--color-zinc-500); font-size: 12px; }
  .canon-film:not(.is-seen) .canon-poster > img:first-child { filter: grayscale(.85) brightness(.6); }
  .canon-film:hover .canon-poster > img:first-child { filter: none; }
  .canon-rank { position: absolute; top: 6px; left: 6px; min-width: 26px; padding: 2px 6px; border-radius: 8px; background: rgb(0 0 0 / .75); color: #fff; font-style: normal; font-size: 12px; font-weight: 900; text-align: center; }
  .canon-w { position: absolute; top: 6px; right: 6px; width: 26px; height: 26px; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  buttons.forEach((b) => b.addEventListener("click", () => {
    buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    const f = b.dataset.filter;
    document.querySelectorAll<HTMLElement>(".canon-grid li").forEach((li) => {
      li.hidden = f === "seen" ? li.dataset.seen !== "1" : f === "unseen" ? li.dataset.seen !== "0" : false;
    });
  }));
</script>
